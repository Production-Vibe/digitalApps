# Playwright MCP artifacts (snapshots/console logs).
.playwright-mcp/

# Артефакты оркестрационных тулов opencode (логи падающих задач и т.п.).
.artifacts/

# Источник номенклатуры (Excel) — не трекается, путь передаётся аргументом скрипта импорта.
Номенклатура продукции.xlsm

# Секреты: страховка к tests/e2e/.gitignore — локальные креды БД и файлы паролей
# никогда не коммитятся (pgpass подключается через {file:...} в opencode.json).
.secrets/
*.pgpass
.pgpass

# Runtime-состояние рабочего контура opencode (дизайн-доки, задачи,
# логи, файловый handoff) — игнорируется, это воркспейс, а не репозиторий.
# .opencode/.gitignore — машинно-локальный и в git не входит.
.opencode/design/
.opencode/tasks/
.opencode/logs/
.opencode/handoff/
.opencode/session/

# Драйвер цикла session-loop: логи, машинное состояние, песочница -Dry
# (сам скрипт .opencode/loop/ralph-loop.ps1 трекается).
.opencode/loop/logs/
.opencode/loop/state.json
.opencode/loop/dry-run/
.opencode/loop/restart-request.json
.opencode/loop/restart-request.json.tmp