# === Локальный dev-контур (npm run dev против локального PostgreSQL) ===
DATABASE_URL=postgresql://production_user:CHANGE_ME@localhost:5432/MOSD
JWT_SECRET=change-me-to-a-strong-secret
VBA_SECRET=change-me-vba-ingest-key
PORT=3000

# === Docker-контур (docker compose up --build) ===
# Секреты для сервиса db. DATABASE_URL сервису app задаёт compose
# (localhost/`db` — переопределяется в docker-compose.yml); здесь можно не трогать.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=digital_narad

# === Web Push (PWA) ===
# Генерация VAPID-ключей: server> npm run push:keys
# APP_URL — публичный https-адрес стенда (для ссылок в push-уведомлениях)
APP_URL=http://localhost:3000
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# === Безопасность (этап 13) ===
# NODE_ENV=production задаётся в docker-compose (app). При NODE_ENV=production
# сервер не стартует, пока JWT_SECRET/VBA_SECRET — дефолтовые (нужны реальные hex).
# COOKIE_SECURE=true — при внешнем https (Funnel); TRUST_PROXY=true — с одним прокси.
# COOKIE_SECURE=true
# TRUST_PROXY=true
