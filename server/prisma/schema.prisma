generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────

enum WorkOrderStatus {
  created
  in_progress
  waiting_otk
  rework
  closed
}

enum LaunchStatus {
  to_launch
  issued
  in_work
  done
}

enum ShiftStatus {
  open
  closed
  auto_closed
}

enum TransitionStatus {
  in_progress
  completed
  checked
}

enum PrintJobStatus {
  pending
  printed
}

enum EmployeeRole {
  master
  shift
  operator
  otk
}

// ─── Models ───────────────────────────────────────────────────────────

model Catalog {
  code            String  @id
  name            String
  designation     String
  designation2    String
  parentQty       Float
  blankType       String
  material        String
  materialGrade   String
  blankSize       String
  wallThickness   Float
  cutLength       Float
  ppb             String
  blankWeight     Float
  partWeight      Float
  cutting         Boolean
  heatTreatment   Boolean
  plasma          Boolean
  turning         Boolean
  milling         Boolean
  drilling        Boolean
  fitting         Boolean
  bending         Boolean
  coating         Boolean
  priority        String

  launches     Launches[]
  workOrders   WorkOrders[]
  printJobs    PrintQueue[]
  queueItems   Queue[]
}

model Launches {
  id              String       @id
  partCode        String
  name            String
  assembly        String
  qty             Float
  paNumber        String
  status          LaunchStatus @default(to_launch)
  createdBy       String
  createdAt       DateTime     @default(now())
  launchType      String       @default("Основной")
  reason          String?
  relatedLaunchId String?

  catalog       Catalog       @relation(fields: [partCode], references: [code])
  workOrders    WorkOrders[]
  relatedLaunch Launches?     @relation("LaunchRework", fields: [relatedLaunchId], references: [id])
  reworkLaunches Launches[]   @relation("LaunchRework")
}

model WorkOrders {
  number         String          @id
  partCode       String
  name           String
  designation    String
  assembly       String
  program        String?
  customer       String?
  sp             String?
  operator       String
  machine        String
  qty            Float
  status         WorkOrderStatus @default(created)
  launchId       String?
  reworkReason   String?

  catalog      Catalog        @relation(fields: [partCode], references: [code])
  launch       Launches?      @relation(fields: [launchId], references: [id])
  transitions  Transitions[]
  closedOrders ClosedOrders[]
  printJob     PrintQueue?
}

model Transitions {
  id          String           @id @default(cuid())
  orderNumber String
  number      String
  description String
  operator    String
  time        Float
  melt        String?
  machine     String
  qty         Float
  status      TransitionStatus @default(in_progress)
  createdAt   DateTime         @default(now())
  accepted    Float?
  defect      Float?

  workOrder WorkOrders @relation(fields: [orderNumber], references: [number])

  @@unique([orderNumber, number])
}

model ClosedOrders {
  id           String   @id @default(cuid())
  orderNumber  String
  acceptedTotal Float
  defectTotal   Float
  defectReason  String?
  comment       String?
  closedBy      String
  closedAt      DateTime @default(now())

  workOrder WorkOrders @relation(fields: [orderNumber], references: [number])
}

model Shifts {
  id        String     @id
  operator  String
  machine   String
  openedAt  DateTime   @default(now())
  closedAt  DateTime?
  status    ShiftStatus @default(open)
}

model PrintQueue {
  id          DateTime       @id @default(now())
  orderNumber String         @unique
  partCode    String
  name        String
  designation String
  assembly    String
  program     String?
  customer    String?
  sp          String?
  operator    String
  machine     String
  qty         Float
  status      PrintJobStatus @default(pending)

  workOrder WorkOrders @relation(fields: [orderNumber], references: [number])
  catalog   Catalog    @relation(fields: [partCode], references: [code])
}

model Employees {
  login    String       @id
  password String
  fullName String
  role     EmployeeRole
}

model Equipment {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model Queue {
  id          Int      @id @default(autoincrement())
  code        String
  name        String
  designation String
  assembly    String
  type        String
  machines    String
  qty         Float
  priority    String
  customer    String?
  sp          String?
  program     String?
  operator    String?
  issueMachine String?
  issue       Boolean  @default(false)
  status      String?

  catalog Catalog @relation(fields: [code], references: [code])
}