<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Администрирование — ЦифровойНаряд</title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#131c30">
  <link rel="icon" href="/icons/icon-192-v2.png" type="image/png">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon-180-v2.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Наряд">
</head>
<body>
  <header class="top-bar">
    <div class="top-bar__brand">ЦифровойНаряд</div>
    <nav class="top-bar__nav">
      <button class="tab-btn active" data-panel="employees" type="button" onclick="switchPanel('employees')">Сотрудники</button>
      <button class="tab-btn" data-panel="catalog" type="button" onclick="switchPanel('catalog')">Номенклатура</button>
      <button class="tab-btn" data-panel="dicts" type="button" onclick="switchPanel('dicts')">Справочники</button>
    </nav>
    <div class="top-bar__user">
      <span class="user-full-name"></span> (admin)
      <button onclick="logout()" class="btn btn--sm">Выйти</button>
    </div>
  </header>
  <main class="container">
    <section id="panel-employees">
      <div class="page-header">
        <h1>Администрирование сотрудников</h1>
        <button onclick="loadEmployees()" class="btn btn--primary">Обновить</button>
      </div>

      <section class="panel">
        <h2>Новый сотрудник</h2>
        <form id="createForm" class="form-grid">
          <div class="form-group">
            <label for="newFullName">ФИО</label>
            <input type="text" id="newFullName" required placeholder="Иванов И. И.">
          </div>
          <div class="form-group">
            <label for="newLogin">Логин</label>
            <input type="text" id="newLogin" required autocomplete="off">
          </div>
          <div class="form-group">
            <label for="newRole">Роль</label>
            <select id="newRole" class="input">
              <option value="operator">Оператор</option>
              <option value="shift">Начальник смены</option>
              <option value="otk">ОТК</option>
              <option value="master">Начальник цеха</option>
            </select>
          </div>
          <div class="form-group">
            <label for="newPassword">Пароль</label>
            <input type="text" id="newPassword" required autocomplete="off" placeholder="минимум 6 символов">
          </div>
          <div class="form-group form-group--inline">
            <button type="submit" class="btn btn--primary">Добавить сотрудника</button>
          </div>
        </form>
      </section>

      <section class="panel">
        <h2>Сотрудники</h2>
        <div id="employeesSection"><p class="muted">Загрузка...</p></div>
      </section>
    </section>

    <section id="panel-catalog" hidden>
      <div class="page-header">
        <h1>Номенклатура</h1>
        <button onclick="window.__CM_RELOAD && window.__CM_RELOAD()" class="btn btn--primary">Обновить</button>
      </div>
      <div id="adminCatalogManager"></div>
    </section>

    <section id="panel-dicts" hidden>
      <div class="page-header">
        <h1>Справочники</h1>
        <button onclick="window.__DICT_RELOAD && window.__DICT_RELOAD()" class="btn btn--primary">Обновить</button>
      </div>
      <div id="adminDictManager"></div>
    </section>
  </main>

  <script src="/api.js"></script>
  <script src="/ui.js"></script>
  <script src="/catalog-manager.js"></script>
  <script src="/dict-manager.js"></script>
  <script>
    (async function() {
      var u = await initSession();
      if (!u) return;
      if (u.role !== 'admin') { location.href = '/'; return; }
      var nameEl = document.querySelector('.user-full-name');
      if (nameEl) nameEl.textContent = u.fullName;
      loadEmployees();
    })();

    var ROLE_LABELS = { admin: 'Администратор', master: 'Начальник цеха', shift: 'Начальник смены', operator: 'Оператор', otk: 'ОТК' };

    function switchPanel(name) {
      document.querySelectorAll('.top-bar__nav .tab-btn').forEach(function (b) {
        b.classList.toggle('active', b.getAttribute('data-panel') === name);
      });
      var emp = document.getElementById('panel-employees');
      var cat = document.getElementById('panel-catalog');
      var dicts = document.getElementById('panel-dicts');
      if (emp) emp.hidden = name !== 'employees';
      if (cat) cat.hidden = name !== 'catalog';
      if (dicts) dicts.hidden = name !== 'dicts';
      if (name === 'catalog' && !window.__catalogManagerAdminMounted) {
        CatalogManager.mount(document.getElementById('adminCatalogManager'), { showMetrics: false });
        window.__catalogManagerAdminMounted = true;
      }
      if (name === 'dicts' && !window.__dictManagerMounted) {
        DictManager.mount(document.getElementById('adminDictManager'));
        window.__dictManagerMounted = true;
      }
    }
    window.__DICT_RELOAD = function () {
      var dm = document.getElementById('adminDictManager');
      if (dm && window.DictManager && window.DictManager.reload) window.DictManager.reload();
    };
    window.__CM_RELOAD = function () {
      var el = document.getElementById('adminCatalogManager');
      if (!el) return;
      el.innerHTML = '';
      window.__catalogManagerAdminMounted = false;
      CatalogManager.mount(el, { showMetrics: false });
      window.__catalogManagerAdminMounted = true;
    };

    document.getElementById('createForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      var btn = this.querySelector('button[type="submit"]');
      btn.disabled = true;
      try {
        var res = await api('/api/admin/employees', {
          method: 'POST',
          body: {
            fullName: document.getElementById('newFullName').value,
            login: document.getElementById('newLogin').value,
            role: document.getElementById('newRole').value,
            password: document.getElementById('newPassword').value
          }
        });
        showToast('Сотрудник добавлен');
        this.reset();
        loadEmployees();
      } catch (err) {
        showToast(err.message, true);
      } finally {
        btn.disabled = false;
      }
    });

    async function loadEmployees() {
      try {
        var list = await api('/api/admin/employees');
        renderEmployees(list);
      } catch (e) {
        showToast(e.message, true);
      }
    }

    function renderEmployees(list) {
      var el = document.getElementById('employeesSection');
      if (!list || list.length === 0) {
        el.innerHTML = emptyBlock('Нет сотрудников');
        return;
      }
      var html = '<table class="table"><thead><tr>' +
        '<th>ФИО</th><th>Логин</th><th>Роль</th><th>Статус</th><th>Действия</th>' +
        '</tr></thead><tbody>';

      list.forEach(function(emp) {
        var canToggle = emp.role !== 'admin' || emp.isActive;
        html += '<tr>' +
          '<td>' + escHtml(emp.fullName) + '</td>' +
          '<td>' + escHtml(emp.login) + '</td>' +
          '<td><select class="input" data-role-select="' + escHtml(emp.login) + '"' + (emp.role === 'admin' ? ' disabled' : '') + '>' +
            roleOptions(emp.role) +
          '</select></td>' +
          '<td><span class="badge ' + (emp.isActive ? 'badge--ok' : 'badge--error') + '">' + (emp.isActive ? 'Активен' : 'Отключён') + '</span></td>' +
          '<td>' +
            '<input type="text" class="input" placeholder="Новый пароль" data-pw="' + escHtml(emp.login) + '" style="width:140px" autocomplete="off">' +
            '<button onclick="applyChanges(\'' + escHtml(emp.login) + '\')" class="btn btn--sm btn--primary">Применить</button>' +
            (canToggle
              ? '<button onclick="toggleActive(\'' + escHtml(emp.login) + '\', ' + (emp.isActive ? 'false' : 'true') + ')" class="btn btn--sm">' + (emp.isActive ? 'Отключить' : 'Включить') + '</button>'
              : '') +
          '</td>' +
          '</tr>';
      });

      html += '</tbody></table>';
      el.innerHTML = html;
    }

    function roleOptions(current) {
      var allowed = ['operator', 'shift', 'otk', 'master'];
      return allowed.map(function(r) {
        var sel = r === current ? ' selected' : '';
        return '<option value="' + r + '"' + sel + '>' + escHtml(ROLE_LABELS[r]) + '</option>';
      }).join('');
    }

    async function applyChanges(login) {
      var roleSel = document.querySelector('[data-role-select="' + login + '"]');
      var pwInput = document.querySelector('[data-pw="' + login + '"]');
      var body = {};
      if (roleSel && !roleSel.disabled) body.role = roleSel.value;
      if (pwInput && pwInput.value) body.password = pwInput.value;
      if (Object.keys(body).length === 0) { showToast('Нечего применить', true); return; }
      try {
        await api('/api/admin/employees/' + encodeURIComponent(login), { method: 'PUT', body: body });
        showToast('Сохранено');
        if (pwInput) pwInput.value = '';
        if (roleSel) roleSel.value = body.role || roleSel.value;
      } catch (e) {
        showToast(e.message, true);
      }
    }

    async function toggleActive(login, isActive) {
      try {
        await api('/api/admin/employees/' + encodeURIComponent(login), { method: 'PATCH', body: { isActive: isActive } });
        showToast(isActive ? 'Учётная запись включена' : 'Учётная запись отключена');
        loadEmployees();
      } catch (e) {
        showToast(e.message, true);
      }
    }
  </script>
</body>
</html>