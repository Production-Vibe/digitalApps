<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>ЦифровойНаряд</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="top-bar">
    <div class="top-bar__brand">ЦифровойНаряд</div>
    <% if (typeof user !== 'undefined' && user) { %>
      <nav class="top-bar__nav">
        <% if (user.role === 'master') { %><a href="/master">Планирование</a><% } %>
        <% if (user.role === 'shift') { %><a href="/shift">Выдача нарядов</a><% } %>
        <% if (user.role === 'operator') { %><a href="/operator">Оператор</a><% } %>
        <% if (user.role === 'otk') { %><a href="/otk">ОТК</a><% } %>
      </nav>
      <div class="top-bar__user">
        <span><%= user.фио %> (<%= user.role %>)</span>
        <button onclick="localStorage.removeItem('token');location.href='/login'" class="btn btn--sm">Выйти</button>
      </div>
    <% } %>
  </header>
  <main class="container">
    <%- body %>
  </main>
</body>
</html>
