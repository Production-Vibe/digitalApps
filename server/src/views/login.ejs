<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Вход — ЦифровойНаряд</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <main class="container">
    <div class="auth-page">
      <div class="auth-card">
        <h1 class="auth-card__title">ЦифровойНаряд</h1>
        <p class="auth-card__subtitle">Управление производством подъёмных агрегатов</p>
        <% if (error) { %>
          <div class="alert alert--error"><%= error %></div>
        <% } %>
        <form id="loginForm" class="auth-form">
          <div class="form-group">
            <label for="login">Логин</label>
            <input type="text" id="login" name="login" required autocomplete="username" autofocus>
          </div>
          <div class="form-group">
            <label for="password">Пароль</label>
            <input type="password" id="password" name="password" required autocomplete="current-password">
          </div>
          <div class="form-group form-group--inline">
            <label for="remember" class="checkbox-label">
              <input type="checkbox" id="remember" checked>
              Запомнить меня
            </label>
          </div>
          <button type="submit" class="btn btn--primary btn--full">Войти</button>
        </form>
      </div>
    </div>
  </main>
  <script src="/api.js"></script>
  <script>
    document.getElementById('loginForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      var form = document.getElementById('loginForm');
      var submitBtn = form.querySelector('button[type="submit"]');
      var login = document.getElementById('login').value;
      var password = document.getElementById('password').value;
      submitBtn.disabled = true;
      try {
        var res = await fetch('/api/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ login: login, password: password })
        });
        var data = await res.json();
        if (res.ok) {
          localStorage.setItem('remember', document.getElementById('remember').checked ? '1' : '0');
          saveSession(data);
          var role = data.user.role;
          if (role === 'master') location.href = '/master';
          else if (role === 'shift') location.href = '/shift';
          else if (role === 'operator') location.href = '/operator';
          else if (role === 'otk') location.href = '/otk';
          else location.href = '/';
        } else {
          var errDiv = document.querySelector('.alert--error');
          if (errDiv) errDiv.textContent = data.error || 'Ошибка авторизации';
          else {
            var d = document.createElement('div');
            d.className = 'alert alert--error';
            d.textContent = data.error || 'Ошибка авторизации';
            document.querySelector('.auth-form').prepend(d);
          }
        }
      } catch {
        alert('Сервер недоступен');
      } finally {
        submitBtn.disabled = false;
      }
    });
  </script>
</body>
</html>
