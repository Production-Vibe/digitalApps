<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Вход — ЦифровойНаряд</title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#131c30">
  <link rel="icon" href="/icons/icon-192-v2.png" type="image/png">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon-180-v2.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Наряд">
</head>
<body>
  <main class="container">
    <div class="auth-page">
      <div class="auth-card">
        <h1 class="auth-card__title">ЦифровойНаряд</h1>
        <p class="auth-card__subtitle">Управление производством подъёмных агрегатов</p>
        <% if (error) { %>
          <div class="alert alert--error"><%= error %></div>
        <% } %>
        <div class="auth-tabs">
          <button type="button" id="tabLogin" class="auth-tab active">Вход</button>
          <button type="button" id="tabRegister" class="auth-tab">Регистрация</button>
        </div>
        <div id="loginPane" class="auth-pane">
          <form id="loginForm" class="auth-form">
            <div class="form-group">
              <label for="login">Логин</label>
              <input type="text" id="login" name="login" required autocomplete="username" autofocus>
            </div>
            <div class="form-group">
              <label for="password">Пароль</label>
              <input type="password" id="password" name="password" required autocomplete="current-password">
            </div>
            <div class="form-group form-group--inline">
              <label for="remember" class="checkbox-label">
                <input type="checkbox" id="remember" checked>
                Запомнить меня
              </label>
            </div>
            <button type="submit" class="btn btn--primary btn--full">Войти</button>
          </form>
        </div>
        <div id="registerPane" class="auth-pane" style="display:none">
          <form id="registerForm" class="auth-form">
            <div class="form-group">
              <label for="regFullName">ФИО</label>
              <input type="text" id="regFullName" required autocomplete="off" placeholder="Иванов И. И.">
            </div>
            <div class="form-group">
              <label for="regLogin">Логин</label>
              <input type="text" id="regLogin" required autocomplete="username">
            </div>
            <div class="form-group">
              <label for="regPassword">Пароль</label>
              <input type="password" id="regPassword" required autocomplete="new-password" placeholder="минимум 6 символов">
            </div>
            <div class="form-group">
              <label for="regConfirm">Повторите пароль</label>
              <input type="password" id="regConfirm" required autocomplete="new-password">
            </div>
            <div class="form-group form-group--inline">
              <label for="regRemember" class="checkbox-label">
                <input type="checkbox" id="regRemember" checked>
                Запомнить меня
              </label>
            </div>
            <button type="submit" class="btn btn--primary btn--full">Зарегистрироваться</button>
            <p class="muted" style="margin-top:0.75rem">Регистрация доступна операторам. Остальные роли создаёт администратор.</p>
          </form>
        </div>
      </div>
    </div>
  </main>
  <script src="/api.js"></script>
  <script>
    function switchTab(name) {
      var isLogin = name === 'login';
      document.getElementById('tabLogin').classList.toggle('active', isLogin);
      document.getElementById('tabRegister').classList.toggle('active', !isLogin);
      document.getElementById('loginPane').style.display = isLogin ? '' : 'none';
      document.getElementById('registerPane').style.display = isLogin ? 'none' : '';
    }
    document.getElementById('tabLogin').addEventListener('click', function() { switchTab('login'); });
    document.getElementById('tabRegister').addEventListener('click', function() { switchTab('register'); });

    function redirectByRole(user) {
      if (user.role === 'admin') location.href = '/admin';
      else if (user.role === 'master') location.href = '/master';
      else if (user.role === 'shift') location.href = '/shift';
      else if (user.role === 'operator') location.href = '/operator';
      else if (user.role === 'otk') location.href = '/otk';
      else location.href = '/';
    }

    function showAuthError(message) {
      var errDiv = document.querySelector('.alert--error');
      if (errDiv) errDiv.textContent = message;
      else {
        var d = document.createElement('div');
        d.className = 'alert alert--error';
        d.textContent = message;
        var card = document.querySelector('.auth-card');
        card.insertBefore(d, card.querySelector('.auth-tabs'));
      }
    }

    document.getElementById('loginForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      var form = document.getElementById('loginForm');
      var submitBtn = form.querySelector('button[type="submit"]');
      var login = document.getElementById('login').value;
      var password = document.getElementById('password').value;
      submitBtn.disabled = true;
      try {
        var res = await fetch('/api/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            login: login,
            password: password,
            remember: document.getElementById('remember').checked
          })
        });
        var data = await res.json();
        if (res.ok) {
          setSession(data.user, data.accessToken);
          redirectByRole(data.user);
        } else {
          showAuthError(data.error || 'Ошибка авторизации');
        }
      } catch {
        alert('Сервер недоступен');
      } finally {
        submitBtn.disabled = false;
      }
    });

    document.getElementById('registerForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      var form = document.getElementById('registerForm');
      var submitBtn = form.querySelector('button[type="submit"]');
      var password = document.getElementById('regPassword').value;
      var confirm = document.getElementById('regConfirm').value;
      if (password !== confirm) {
        showAuthError('Пароли не совпадают');
        return;
      }
      submitBtn.disabled = true;
      try {
        var res = await fetch('/api/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            fullName: document.getElementById('regFullName').value,
            login: document.getElementById('regLogin').value,
            password: password,
            confirmPassword: confirm,
            remember: document.getElementById('regRemember').checked
          })
        });
        var data = await res.json();
        if (res.ok) {
          setSession(data.user, data.accessToken);
          redirectByRole(data.user);
        } else {
          showAuthError(data.error || 'Ошибка регистрации');
        }
      } catch {
        alert('Сервер недоступен');
      } finally {
        submitBtn.disabled = false;
      }
    });
  </script>
</body>
</html>