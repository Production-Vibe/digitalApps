<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Мастер — ЦифровойНаряд</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="top-bar">
    <div class="top-bar__brand">ЦифровойНаряд</div>
    <nav class="top-bar__nav">
      <button class="tab-btn active" data-tab="svodka" type="button" onclick="switchTab('svodka')">Сводка</button>
      <button class="tab-btn" data-tab="plan" type="button" onclick="switchTab('plan')">Планирование</button>
      <button class="tab-btn" data-tab="nomenclatura" type="button" onclick="switchTab('nomenclatura')">Номенклатура</button>
      <button class="tab-btn" data-tab="otchety" type="button" onclick="switchTab('otchety')">Отчёты</button>
    </nav>
    <div class="top-bar__user">
      <span class="user-full-name"></span> (master)
      <button onclick="logout()" class="btn btn--sm">Выйти</button>
    </div>
  </header>
  <main class="container">

    <section id="tab-svodka" class="tab-panel">
      <div class="page-header">
        <h1>Сводка по цеху</h1>
        <button onclick="loadDashboard()" class="btn btn--primary">Обновить</button>
      </div>
      <div id="launchCardsSection"></div>
      <div id="orderCardsSection"></div>
      <div id="ordersChartSection"></div>
      <div id="paChartSection"></div>
      <div id="paLoadSection"></div>
      <div id="machinesSection"></div>
    </section>

    <section id="tab-plan" class="tab-panel" hidden>
      <div class="page-header">
        <h1>Планирование запусков</h1>
        <button onclick="loadAll()" class="btn btn--primary">Обновить</button>
      </div>

      <div id="statsSection"></div>

      <div class="panel">
        <h3>Создать запуск</h3>
        <div class="launch-form">
          <div class="form-group">
            <label for="launchSearch">Деталь (поиск)</label>
            <input type="text" id="launchSearch" class="input" placeholder="Введите код или наименование" oninput="searchCatalog()">
          </div>
          <div id="catalogResults" style="max-height:200px;overflow-y:auto;margin-bottom:0.75rem"></div>
          <div id="selectedItem" class="muted"></div>
          <div class="form-group">
            <label for="launchQty">Кол-во</label>
            <input type="number" id="launchQty" class="input" min="1" value="1">
          </div>
          <div class="form-group">
            <label for="launchPA">№ ПА</label>
            <input type="text" id="launchPA" class="input" placeholder="001 или 009-011">
          </div>
          <div class="form-group">
            <label for="launchType">Тип запуска</label>
            <select id="launchType" class="input">
              <option value="Основной">Основной</option>
              <option value="Дополнительный">Дополнительный</option>
              <option value="Доработка">Доработка</option>
            </select>
          </div>
          <button onclick="createLaunch()" class="btn btn--primary">Создать запуск</button>
        </div>
      </div>

      <div id="launchesSection"></div>
    </section>

    <section id="tab-nomenclatura" class="tab-panel" hidden>
      <div class="page-header">
        <h1>Номенклатура</h1>
        <button onclick="loadDashboard()" class="btn btn--primary">Обновить</button>
      </div>
      <div id="treeSection"></div>
    </section>

    <section id="tab-otchety" class="tab-panel" hidden>
      <div class="page-header">
        <h1>Отчёты</h1>
      </div>
      <div class="panel">
        <h3>Период</h3>
        <div class="report-form">
          <label for="repFrom">От <input type="date" id="repFrom" class="input"></label>
          <label for="repTo">До <input type="date" id="repTo" class="input"></label>
          <button onclick="applyReport()" class="btn btn--primary">Показать</button>
        </div>
      </div>
      <div id="timelineSection"></div>
      <div id="execSection"></div>
      <div id="operatorsSection"></div>
      <div id="reportMachinesSection"></div>
    </section>

  </main>

  <script src="/api.js"></script>
  <script src="/ui.js"></script>
  <script src="/vendor/chart.umd.min.js"></script>
  <script>
    (function() {
      var u = getCurrentUser();
      if (!u) { location.href = '/login'; return; }
      if (u.role !== 'master') { location.href = '/'; return; }
      var nameEl = document.querySelector('.user-full-name');
      if (nameEl) nameEl.textContent = u.fullName;
    })();

    var selectedCatalogItem = null;
    var searchTimer = null;
    var dashboard = null;

    var LAUNCH_LABELS = { to_launch: 'К запуску', issued: 'Выдано', in_work: 'В работе', done: 'Готово' };
    var ORDER_LABELS = { created: 'Создан', in_progress: 'В работе', waiting_otk: 'Ждёт ОТК', rework: 'Доработка', closed: 'Закрыт' };
    var ORDER_BADGE = { created: 'info', in_progress: 'warn', waiting_otk: 'warn', rework: 'error', closed: 'ok' };

    function switchTab(name) {
      document.querySelectorAll('.tab-btn').forEach(function(b) {
        b.classList.toggle('active', b.getAttribute('data-tab') === name);
      });
      document.querySelectorAll('.tab-panel').forEach(function(p) {
        p.hidden = (p.id !== 'tab-' + name);
      });
    }

    var STATUS_COLORS = {
      created: '#60a5fa',
      in_progress: '#f59e0b',
      waiting_otk: '#f97316',
      rework: '#ef4444',
      closed: '#10b981'
    };
    var STATUS_ORDER = [
      { key: 'created', label: 'Создан' },
      { key: 'in_progress', label: 'В работе' },
      { key: 'waiting_otk', label: 'Ждёт ОТК' },
      { key: 'rework', label: 'Доработка' },
      { key: 'closed', label: 'Закрыт' }
    ];

    function renderOrdersChart(d) {
      var el = document.getElementById('ordersChartSection');
      if (!el) return;
      var s = d.summary.ordersByStatus || {};
      var labels = [];
      var data = [];
      var colors = [];
      STATUS_ORDER.forEach(function(item) {
        if (s[item.key]) {
          labels.push(item.label);
          data.push(s[item.key]);
          colors.push(STATUS_COLORS[item.key]);
        }
      });
      if (data.length === 0) {
        el.innerHTML = '<div class="panel"><h3>Наряды по статусам</h3>' + emptyBlock('Нет нарядов') + '</div>';
        return;
      }
      el.innerHTML = chartBoxHtml('ordersChart', 'Наряды по статусам');
      drawChart('ordersChart', {
        type: 'bar',
        data: { labels: labels, datasets: [{ data: data, backgroundColor: colors, borderRadius: 4, maxBarThickness: 52 }] },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
        }
      });
    }

    function renderPaChart(d) {
      var el = document.getElementById('paChartSection');
      if (!el) return;
      var pa = d.summary.paLoad || [];
      if (!pa.length) {
        el.innerHTML = '<div class="panel"><h3>Загруженность ПА</h3>' + emptyBlock('Нет активных запусков') + '</div>';
        return;
      }
      el.innerHTML = chartBoxHtml('paChart', 'Загруженность ПА');
      drawChart('paChart', {
        type: 'bar',
        data: {
          labels: pa.map(function(p) { return p.paNumber; }),
          datasets: [{ data: pa.map(function(p) { return roundSmart(p.qty); }), backgroundColor: '#60a5fa', borderRadius: 4, maxBarThickness: 52 }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true } }
        }
      });
    }

    function renderTimeline(d) {
      var el = document.getElementById('timelineSection');
      if (!el) return;
      var daily = (d.reports && d.reports.daily) || [];
      if (!daily.length) {
        el.innerHTML = '<div class="panel"><h3>Динамика закрытия нарядов</h3>' + emptyBlock('За период закрытых нарядов нет') + '</div>';
        return;
      }
      el.innerHTML = chartBoxHtml('timelineChart', 'Динамика закрытия нарядов');
      drawChart('timelineChart', {
        type: 'bar',
        data: {
          labels: daily.map(function(r) { return r.day.slice(5); }),
          datasets: [
            { label: 'Нарядов', data: daily.map(function(r) { return r.orders; }), backgroundColor: '#2563eb', borderRadius: 3, maxBarThickness: 26, yAxisID: 'y' },
            { label: 'Объём', data: daily.map(function(r) { return roundSmart(r.qty); }), type: 'line', borderColor: '#f59e0b', backgroundColor: '#f59e0b', tension: 0.3, yAxisID: 'y1' }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: { beginAtZero: true, position: 'left', ticks: { precision: 0 } },
            y1: { beginAtZero: true, position: 'right', grid: { drawOnChartArea: false }, ticks: { precision: 2 } }
          }
        }
      });
    }

    function renderSummary(d) {
      var s = d.summary;
      statCards('launchCardsSection', s.launchesByStatus, LAUNCH_LABELS)
      statCards('orderCardsSection', s.ordersByStatus, ORDER_LABELS)
      renderOrdersChart(d);
      renderPaChart(d);

      var paEl = document.getElementById('paLoadSection');
      if (!s.paLoad || s.paLoad.length === 0) {
        paEl.innerHTML = '<div class="panel"><h3>Активные запуски по ПА</h3>' + emptyBlock('Нет активных запусков') + '</div>';
      } else {
        var rows = s.paLoad.map(function(p) {
          return '<tr><td class="mono">' + escHtml(p.paNumber) + '</td><td class="num">' + fmtNum(p.launches) + '</td><td class="num">' + fmtNum(p.qty) + '</td></tr>';
        }).join('');
        paEl.innerHTML = '<div class="panel"><h3>Активные запуски по ПА</h3>' +
          '<div class="tablewrap"><table class="table"><thead><tr><th>№ ПА</th><th>Запусков</th><th>Кол-во</th></tr></thead>' +
          '<tbody>' + rows + '</tbody></table></div></div>';
      }

      var mEl = document.getElementById('machinesSection');
      var busyRows = (s.machinesBusy || []).map(function(m) {
        return '<tr><td class="mono">' + escHtml(m.machine) + '</td><td>' + escHtml(m.operator) + '</td><td>' + fmtDate(m.since) + '</td></tr>';
      }).join('');
      var idle = (s.machinesIdle || []).join(', ');
      mEl.innerHTML = '<div class="panel"><h3>Станки</h3>' +
        (s.machinesBusy && s.machinesBusy.length
          ? '<div class="tablewrap"><table class="table"><thead><tr><th>Станок</th><th>Оператор</th><th>Смена с</th></tr></thead><tbody>' + busyRows + '</tbody></table></div>'
          : emptyBlock('Смены не открыты')) +
        (idle ? '<p class="muted" style="margin-top:0.5rem">Свободны: ' + escHtml(idle) + '</p>' : '') +
        '</div>';
    }

    function renderTree(d) {
      var el = document.getElementById('treeSection');
      var units = d.nomenclature.units;
      if (!units || units.length === 0) {
        el.innerHTML = '<div class="panel"><h3>Номенклатура</h3>' + emptyBlock('Каталог пуст') + '</div>';
        return;
      }
      var html = '<div class="panel"><h3>Номенклатура</h3>';
      units.forEach(function(u) {
        var rows = u.items.map(function(i) {
          return '<tr><td>' + escHtml(i.designation || '—') + '</td><td>' + escHtml(i.name) + '</td>' +
            '<td>' + fmtNum(i.activeLaunches) + '</td><td>' + fmtNum(i.inWork) + '</td><td>' + fmtNum(i.closed) + '</td></tr>';
        }).join('');
        html += '<details style="margin-bottom:0.5rem"><summary><strong>' + escHtml(u.unit) + '</strong>' +
          ' <span class="muted">(в запуске: ' + fmtNum(u.totals.activeLaunches) + ', в работе: ' + fmtNum(u.totals.inWork) + ', закрыто: ' + fmtNum(u.totals.closed) + ')</span></summary>' +
          '<div class="tablewrap"><table class="table"><thead><tr><th>Обозначение</th><th>Наименование</th><th>В запуске</th><th>В работе</th><th>Закрыто</th></tr></thead>' +
          '<tbody>' + rows + '</tbody></table></div></details>';
      });
      html += '</div>';
      el.innerHTML = html;
    }

    function renderReports(d) {
      var r = d.reports;
      var e = r.exec;
      renderTimeline(d);
      document.getElementById('execSection').innerHTML = '<div class="panel"><h3>Выполнение за период</h3>' +
        '<p class="muted">' + r.from + ' — ' + r.to + '</p>' +
        '<div class="tablewrap"><table class="table"><thead><tr><th>Закрыто нарядов</th><th>Объём</th><th>Принято</th><th>Брак</th><th>Брак, %</th><th>Нормо-часы</th></tr></thead>' +
        '<tbody><tr><td class="num">' + fmtNum(e.orders) + '</td><td class="num">' + fmtNum(e.qty) + '</td><td class="num">' + fmtNum(e.accepted) + '</td><td class="num">' + fmtNum(e.defect) + '</td><td class="num">' + fmtNum(e.defectPct) + '</td><td class="num">' + fmtNum(e.time) + '</td></tr></tbody></table></div></div>';

      document.getElementById('operatorsSection').innerHTML =
        reportTable('Отчёты по операторам', r.operators, 'operator');
      document.getElementById('reportMachinesSection').innerHTML =
        reportTable('Отчёты по станкам', r.machines, 'machine');
    }

    function reportTable(title, rows, keyName) {
      var keyLabel = keyName === 'operator' ? 'Оператор' : 'Станок';
      var head = '<div class="panel"><h3>' + title + '</h3>';
      if (!rows || rows.length === 0) return head + emptyBlock('За период закрытых нарядов нет') + '</div>';
      var body = rows.map(function(x) {
        return '<tr><td>' + escHtml(x[keyName]) + '</td><td class="num">' + fmtNum(x.orders) + '</td><td class="num">' + fmtNum(x.qty) + '</td><td class="num">' +
          fmtNum(x.accepted) + '</td><td class="num">' + fmtNum(x.defect) + '</td><td class="num">' + fmtNum(x.defectPct) + '</td><td class="num">' + fmtNum(x.time) + '</td></tr>';
      }).join('');
      return head + '<div class="tablewrap"><table class="table"><thead><tr><th>' + keyLabel + '</th><th>Нарядов</th><th>Объём</th><th>Принято</th><th>Брак</th><th>Брак, %</th><th>Нормо-часы</th></tr></thead>' +
        '<tbody>' + body + '</tbody></table></div></div>';
    }

    function defaultPeriod() {
      function fmt(d) {
        return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
      }
      var to = new Date();
      var from = new Date(to.getTime() - 29 * 86400000);
      var fEl = document.getElementById('repFrom');
      var tEl = document.getElementById('repTo');
      if (fEl && !fEl.value) fEl.value = fmt(from);
      if (tEl && !tEl.value) tEl.value = fmt(to);
    }

    async function loadDashboard() {
      try {
        var q = '';
        var fEl = document.getElementById('repFrom');
        var tEl = document.getElementById('repTo');
        if (fEl && fEl.value) q += '?from=' + encodeURIComponent(fEl.value);
        if (tEl && tEl.value) q += (q ? '&' : '?') + 'to=' + encodeURIComponent(tEl.value);
        dashboard = await api('/api/analytics/dashboard' + q);
        renderSummary(dashboard);
        renderTree(dashboard);
        renderReports(dashboard);
      } catch (e) {
        showToast(e.message, true);
      }
    }

    function applyReport() {
      loadDashboard();
    }

    async function loadAll() {
      try {
        var [launches, catalog] = await Promise.all([
          api('/api/launches'),
          api('/api/catalog')
        ]);
        renderStats(launches);
        renderLaunches(launches);
      } catch (e) {
        showToast(e.message, true);
      }
    }

    function renderStats(launches) {
      var el = document.getElementById('statsSection');
      if (!launches) launches = [];
      var counts = { to_launch: 0, issued: 0, in_work: 0, done: 0 };
      launches.forEach(function(l) {
        if (counts[l.status] !== undefined) counts[l.status]++;
      });
      el.innerHTML = '<div class="stat-grid">';
      Object.keys(counts).forEach(function(k) {
        el.innerHTML += '<div class="stat-card"><div class="stat-card__value">' + counts[k] + '</div>' +
          '<div class="stat-card__label">' + LAUNCH_LABELS[k] + '</div></div>';
      });
      el.innerHTML += '</div>';
    }

    function renderLaunches(launches) {
      var el = document.getElementById('launchesSection');
      if (!launches || launches.length === 0) {
        el.innerHTML = '<div class="panel"><h3>Запуски</h3>' + emptyBlock('Нет запусков') + '</div>';
        return;
      }
      var html = '<div class="panel"><h3>Запуски</h3><div class="tablewrap"><table class="table"><thead><tr>' +
        '<th>ID</th><th>Обозначение</th><th>Наименование</th><th>ПА</th><th>Кол-во</th><th>Статус</th><th>Дата</th><th></th></tr></thead><tbody>';
      launches.forEach(function(l) {
        var canDelete = l.status === 'to_launch';
        var desig = (l.catalog && l.catalog.designation) || l.partCode;
        html += '<tr>' +
          '<td>' + escHtml(l.id) + '</td>' +
          '<td>' + escHtml(desig) + '</td>' +
          '<td>' + escHtml(l.name) + '</td>' +
          '<td>' + escHtml(l.paNumber) + '</td>' +
          '<td>' + fmtNum(l.qty) + '</td>' +
          '<td><span class="badge badge--' + (l.status === 'to_launch' ? 'info' : (l.status === 'issued' ? 'warn' : (l.status === 'done' ? 'ok' : 'muted'))) + '">' + escHtml(LAUNCH_LABELS[l.status] || l.status) + '</span></td>' +
          '<td>' + fmtDate(l.createdAt) + '</td>' +
          '<td>' + (canDelete ? '<button onclick="deleteLaunch(\'' + escHtml(l.id) + '\')" class="btn btn--sm">Удалить</button>' : '') + '</td>' +
          '</tr>';
      });
      html += '</tbody></table></div></div>';
      el.innerHTML = html;
    }

    async function searchCatalog() {
      clearTimeout(searchTimer);
      var input = document.getElementById('launchSearch');
      var results = document.getElementById('catalogResults');
      if (!(input.value.trim().length >= 2)) {
        results.innerHTML = '';
        return;
      }
      searchTimer = setTimeout(async function() {
        try {
          var items = await api('/api/catalog?search=' + encodeURIComponent(input.value.trim()));
          if (!items || items.length === 0) {
            results.innerHTML = '<p class="muted">Ничего не найдено</p>';
            return;
          }
          results.innerHTML = items.map(function(item) {
            return '<div class="catalog-item" onclick="selectCatalogItem(\'' + escHtml(item.code) + '\', \'' + escHtml(item.name) + '\', \'' + escHtml(item.designation) + '\')">' +
              escHtml(item.designation ? item.designation + ' — ' + item.name : item.name) + '</div>';
          }).join('');
        } catch (e) {
          showToast(e.message, true);
        }
      }, 350);
    }

    function selectCatalogItem(code, name, designation) {
      selectedCatalogItem = { code: code, name: name };
      var label = designation ? designation + ' — ' + name : name;
      document.getElementById('launchSearch').value = label;
      document.getElementById('catalogResults').innerHTML = '';
      document.getElementById('selectedItem').innerHTML = '<strong>Выбрано:</strong> ' + escHtml(label);
    }

    async function createLaunch() {
      if (!selectedCatalogItem) { showToast('Сначала выберите деталь', true); return; }
      var qty = parseFloat(document.getElementById('launchQty').value);
      var paNumber = document.getElementById('launchPA').value.trim();
      var launchType = document.getElementById('launchType').value;
      var user = getCurrentUser();
      if (!qty || qty <= 0) { showToast('Укажите количество', true); return; }
      if (!paNumber) { showToast('Укажите № ПА', true); return; }

      try {
        await api('/api/launches', {
          method: 'POST',
          body: {
            partCode: selectedCatalogItem.code,
            name: selectedCatalogItem.name,
            assembly: '',
            qty: qty,
            paNumber: paNumber,
            createdBy: user ? user.fullName : '',
            launchType: launchType
          }
        });
        showToast('Запуск создан');
        selectedCatalogItem = null;
        document.getElementById('launchSearch').value = '';
        document.getElementById('selectedItem').innerHTML = '';
        document.getElementById('launchQty').value = '1';
        document.getElementById('launchPA').value = '';
        loadAll();
      } catch (e) {
        showToast(e.message, true);
      }
    }

    async function deleteLaunch(id) {
      if (!confirm('Удалить запуск ' + id + '? Связанные наряды будут удалены.')) return;
      try {
        await api('/api/launches/' + encodeURIComponent(id), { method: 'DELETE' });
        showToast('Запуск удалён');
        loadAll();
      } catch (e) {
        showToast(e.message, true);
      }
    }

    defaultPeriod();
    switchTab('svodka');
    loadAll();
    loadDashboard();
  </script>
</body>
</html>