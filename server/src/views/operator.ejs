<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Оператор — ЦифровойНаряд</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="top-bar">
    <div class="top-bar__brand">ЦифровойНаряд</div>
    <nav class="top-bar__nav">
      <a href="/operator" class="active">Оператор</a>
    </nav>
    <div class="top-bar__user">
      <span class="user-full-name"></span> (operator)
      <button onclick="localStorage.clear();location.href='/login'" class="btn btn--sm">Выйти</button>
    </div>
  </header>
  <main class="container">
    <div class="page-header">
      <h1>Оператор</h1>
      <button onclick="loadAll()" class="btn btn--primary">Обновить</button>
    </div>

    <div id="shiftsSection"></div>
    <div id="ordersSection"></div>
  </main>

  <div id="transitionModal" class="modal" style="display:none">
    <div class="modal-content">
      <h3>Отметить переход</h3>
      <div id="transitionOrderInfo"></div>
      <div class="form-group">
        <label for="trDescription">Описание операции</label>
        <input type="text" id="trDescription" class="input">
      </div>
      <div class="form-group">
        <label for="trTime">Время (ч)</label>
        <input type="number" id="trTime" class="input" step="0.1" min="0">
      </div>
      <div class="form-group">
        <label for="trQty">Кол-во</label>
        <input type="number" id="trQty" class="input" min="1">
      </div>
      <div class="form-group">
        <label for="trMelt">Плавка</label>
        <input type="text" id="trMelt" class="input">
      </div>
      <div class="modal-actions">
        <button onclick="closeTransitionModal()" class="btn btn--sm">Отмена</button>
        <button onclick="submitTransition()" class="btn btn--primary">Отправить</button>
      </div>
    </div>
  </div>

  <script src="/api.js"></script>
  <script>
    (function() {
      var u = getCurrentUser();
      if (!u) { location.href = '/login'; return; }
      if (u.role !== 'operator') { location.href = '/'; return; }
      var nameEl = document.querySelector('.user-full-name');
      if (nameEl) nameEl.textContent = u.fullName;
    })();

    var currentOrder = null;
    var currentShift = null;

    async function loadAll() {
      var user = getCurrentUser();
      if (!user) { location.href = '/login'; return; }
      var fullName = user.fullName;

      try {
        var [shifts, orders, machines] = await Promise.all([
          api('/api/shifts/my?operator=' + encodeURIComponent(fullName)),
          api('/api/work-orders/my/list?operator=' + encodeURIComponent(fullName)),
          api('/api/equipment')
        ]);
        renderShifts(shifts, machines);
        renderOrders(orders);
      } catch (e) {
        showToast(e.message, true);
      }
    }

    function renderShifts(shifts, machines) {
      var el = document.getElementById('shiftsSection');
      if (!shifts || shifts.length === 0) {
        el.innerHTML = '<div class="panel"><h3>Смены</h3><p class="muted">Откройте смену на станке</p>' +
          '<div class="form-group" style="margin-top:0.5rem"><select id="openMachine" class="input"></select></div>' +
          '<button onclick="openShift()" class="btn btn--primary">Открыть смену</button></div>';
        var sel = document.getElementById('openMachine');
        if (sel) sel.innerHTML = machines.map(function(m) {
          return '<option value="' + escHtml(m.name) + '">' + escHtml(m.name) + '</option>';
        }).join('');
        return;
      }

      var html = '<div class="panel"><h3>Смены</h3><div class="tablewrap"><table class="table"><thead><tr>' +
        '<th>ID</th><th>Станок</th><th>Открыта</th><th>Статус</th><th></th></tr></thead><tbody>';

      shifts.forEach(function(s) {
        var isOpen = s.status === 'open';
        html += '<tr>' +
          '<td>' + escHtml(s.id) + '</td>' +
          '<td>' + escHtml(s.machine) + '</td>' +
          '<td>' + fmtDate(s.openedAt) + '</td>' +
          '<td><span class="badge ' + (isOpen ? 'badge--ok' : 'badge--muted') + '">' + escHtml(s.status === 'open' ? 'Открыта' : (s.status === 'closed' ? 'Закрыта' : 'Авто-закрыта')) + '</span></td>' +
          '<td>' + (isOpen ? '<button onclick="closeShift(\'' + escHtml(s.id) + '\')" class="btn btn--sm">Закрыть</button>' : '') + '</td>' +
          '</tr>';
      });

      html += '</tbody></table></div></div>';
      el.innerHTML = html;
    }

    function renderOrders(orders) {
      var el = document.getElementById('ordersSection');
      if (!orders || orders.length === 0) {
        el.innerHTML = '<div class="panel"><h3>Наряды</h3><p class="muted">Нет активных нарядов</p></div>';
        return;
      }

      var html = '<div class="panel"><h3>Наряды в работе</h3><div class="tablewrap"><table class="table"><thead><tr>' +
        '<th>Наряд</th><th>Деталь</th><th>Наименование</th><th>Кол-во</th><th>Статус</th><th></th></tr></thead><tbody>';

      var statusLabels = { created: 'Создан', in_progress: 'В работе', waiting_otk: 'Ждёт ОТК', rework: 'Доработка', closed: 'Закрыт' };

      orders.forEach(function(o) {
        var label = statusLabels[o.status] || o.status;
        var badge = o.status === 'in_progress' ? 'badge--info' : (o.status === 'created' ? 'badge--warn' : (o.status === 'waiting_otk' ? 'badge--ok' : (o.status === 'rework' ? 'badge--error' : 'badge--muted')));
        html += '<tr>' +
          '<td>' + escHtml(o.number) + '</td>' +
          '<td>' + escHtml(o.partCode) + '</td>' +
          '<td>' + escHtml(o.name) + '</td>' +
          '<td>' + o.qty + '</td>' +
          '<td><span class="badge ' + badge + '">' + escHtml(label) + '</span></td>' +
          '<td>' + (o.status === 'created' ? '<button onclick="takeOrder(\'' + escHtml(o.number) + '\')" class="btn btn--sm btn--primary">В работу</button>' : '') +
          (o.status === 'in_progress' || o.status === 'rework' ? '<button onclick="openTransitionModal(\'' + escHtml(o.number) + '\')" class="btn btn--sm">+ Переход</button>' : '') + '</td>' +
          '</tr>';
      });

      html += '</tbody></table></div></div>';
      el.innerHTML = html;
    }

    async function openShift() {
      var user = getCurrentUser();
      var machine = document.getElementById('openMachine').value;
      if (!machine) { showToast('Выберите станок', true); return; }
      try {
        await api('/api/shifts/open', { method: 'POST', body: { operator: user.fullName, machine: machine } });
        showToast('Смена открыта');
        loadAll();
      } catch (e) {
        showToast(e.message, true);
      }
    }

    async function closeShift(shiftId) {
      try {
        await api('/api/shifts/close/' + encodeURIComponent(shiftId), { method: 'POST' });
        showToast('Смена закрыта');
        loadAll();
      } catch (e) {
        showToast(e.message, true);
      }
    }

    async function takeOrder(number) {
      try {
        await api('/api/work-orders/' + encodeURIComponent(number) + '/status', {
          method: 'PUT',
          body: { status: 'in_progress' }
        });
        showToast('Наряд принят в работу');
        loadAll();
      } catch (e) {
        showToast(e.message, true);
      }
    }

    async function openTransitionModal(number) {
      currentOrder = number;
      try {
        var order = await api('/api/work-orders/' + encodeURIComponent(number));
        document.getElementById('transitionOrderInfo').innerHTML =
          '<p><strong>Наряд:</strong> ' + escHtml(order.number) + '</p>' +
          '<p><strong>Деталь:</strong> ' + escHtml(order.partCode) + ' — ' + escHtml(order.name) + '</p>' +
          '<p><strong>Станок:</strong> ' + escHtml(order.machine) + ' | <strong>Кол-во:</strong> ' + order.qty + '</p>';
        document.getElementById('transitionModal').style.display = 'flex';
      } catch (e) {
        showToast(e.message, true);
      }
    }

    function closeTransitionModal() {
      document.getElementById('transitionModal').style.display = 'none';
      currentOrder = null;
    }

    async function submitTransition() {
      if (!currentOrder) return;
      var user = getCurrentUser();
      var description = document.getElementById('trDescription').value;
      var time = parseFloat(document.getElementById('trTime').value) || 0;
      var qty = parseFloat(document.getElementById('trQty').value) || 0;
      var melt = document.getElementById('trMelt').value;

      if (!description) { showToast('Укажите описание', true); return; }
      if (!qty || qty <= 0) { showToast('Укажите количество', true); return; }

      try {
        var order = await api('/api/work-orders/' + encodeURIComponent(currentOrder));
        await api('/api/transitions', {
          method: 'POST',
          body: {
            orderNumber: currentOrder,
            description: description,
            operator: user.fullName,
            time: time,
            melt: melt,
            machine: order.machine,
            qty: qty
          }
        });
        showToast('Переход записан');
        closeTransitionModal();
        loadAll();
      } catch (e) {
        showToast(e.message, true);
      }
    }

    loadAll();
  </script>
</body>
</html>