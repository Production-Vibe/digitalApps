<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Выдача нарядов — ЦифровойНаряд</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="top-bar">
    <div class="top-bar__brand">ЦифровойНаряд</div>
    <nav class="top-bar__nav">
      <a href="/shift" class="active">Выдача нарядов</a>
    </nav>
    <div class="top-bar__user">
      <span><%= user.фио %> (shift)</span>
      <button onclick="localStorage.clear();location.href='/login'" class="btn btn--sm">Выйти</button>
    </div>
  </header>
  <main class="container">
    <div class="page-header">
      <h1>Выдача нарядов</h1>
      <button onclick="loadLaunches()" class="btn btn--primary">Обновить</button>
    </div>

    <div class="filter-bar">
      <input type="text" id="filterSearch" placeholder="Поиск по детали/наименованию" class="input">
      <select id="filterStatus" class="input" onchange="loadLaunches()">
        <option value="">Все статусы</option>
        <option value="К_запуску">К запуску</option>
        <option value="Выдано">Выдано</option>
        <option value="В_работе">В работе</option>
        <option value="Готово">Готово</option>
      </select>
    </div>

    <div id="launchTable">
      <p class="muted">Загрузка...</p>
    </div>
  </main>

  <div id="issueModal" class="modal" style="display:none">
    <div class="modal-content">
      <h3>Выдача наряда</h3>
      <div id="issueDetails"></div>
      <div class="form-group">
        <label for="issueOperator">Оператор</label>
        <select id="issueOperator" class="input"></select>
      </div>
      <div class="form-group">
        <label for="issueMachine">Станок</label>
        <select id="issueMachine" class="input"></select>
      </div>
      <div class="form-group">
        <label for="issueQty">Количество</label>
        <input type="number" id="issueQty" class="input" min="1">
      </div>
      <div class="modal-actions">
        <button onclick="closeIssueModal()" class="btn btn--sm">Отмена</button>
        <button onclick="submitIssue()" class="btn btn--primary">Выдать наряд</button>
      </div>
    </div>
  </div>

  <script src="/api.js"></script>
  <script>
    var currentLaunch = null;

    async function loadLaunches() {
      var status = document.getElementById('filterStatus').value;
      var url = '/api/launches' + (status ? '?status=' + encodeURIComponent(status) : '');
      try {
        var launches = await api(url);
        renderLaunches(launches);
      } catch (e) {
        showToast(e.message, true);
      }
    }

    function renderLaunches(launches) {
      var search = (document.getElementById('filterSearch').value || '').toLowerCase();
      var container = document.getElementById('launchTable');

      if (!launches || launches.length === 0) {
        container.innerHTML = '<p class="muted">Нет запусков</p>';
        return;
      }

      var filtered = launches;
      if (search) {
        filtered = launches.filter(function(l) {
          return (l.наименование || '').toLowerCase().indexOf(search) >= 0 ||
                 (l.кодДетали || '').toLowerCase().indexOf(search) >= 0;
        });
      }

      var html = '<table class="table"><thead><tr>' +
        '<th>ID</th><th>Деталь</th><th>Наименование</th><th>ПА</th><th>Кол-во</th><th>Статус</th><th>Дата</th><th></th>' +
        '</tr></thead><tbody>';

      filtered.forEach(function(l) {
        var statusLabels = { 'К_запуску': 'К запуску', 'Выдано': 'Выдано', 'В_работе': 'В работе', 'Готово': 'Готово' };
        var statusLabel = statusLabels[l.статус] || l.статус;
        var canIssue = l.статус === 'К_запуску';
        html += '<tr>' +
          '<td>' + escHtml(l.id) + '</td>' +
          '<td>' + escHtml(l.кодДетали) + '</td>' +
          '<td>' + escHtml(l.наименование) + '</td>' +
          '<td>' + escHtml(l.номерПА) + '</td>' +
          '<td>' + l.колВо + '</td>' +
          '<td><span class="badge badge--' + escHtml(l.статус === 'К_запуску' ? 'info' : (l.статус === 'Выдано' ? 'warn' : (l.статус === 'Готово' ? 'ok' : 'muted'))) + '">' + escHtml(statusLabel) + '</span></td>' +
          '<td>' + fmtDate(l.дата) + '</td>' +
          '<td>' + (canIssue ? '<button onclick="openIssueModal(\'' + escHtml(l.id) + '\')" class="btn btn--sm btn--primary">Выдать</button>' : '') + '</td>' +
          '</tr>';
      });

      html += '</tbody></table>';
      container.innerHTML = html;
    }

    async function openIssueModal(launchId) {
      try {
        var [launch, operators, machines] = await Promise.all([
          api('/api/launches/' + encodeURIComponent(launchId)),
          api('/api/shifts/active-operators'),
          api('/api/equipment')
        ]);
        currentLaunch = launch;

        var opSelect = document.getElementById('issueOperator');
        var machineSelect = document.getElementById('issueMachine');

        opSelect.innerHTML = operators.length === 0
          ? '<option value="">Нет активных операторов</option>'
          : operators.map(function(o) {
              return '<option value="' + escHtml(o.оператор) + '" data-station="' + escHtml(o.станок) + '">' + escHtml(o.оператор) + ' (' + escHtml(o.станок) + ')</option>';
            }).join('');

        machineSelect.innerHTML = machines.map(function(m) {
          return '<option value="' + escHtml(m.название) + '">' + escHtml(m.название) + '</option>';
        }).join('');

        document.getElementById('issueDetails').innerHTML =
          '<p><strong>Запуск:</strong> ' + escHtml(launch.id) + '</p>' +
          '<p><strong>Деталь:</strong> ' + escHtml(launch.кодДетали) + ' — ' + escHtml(launch.наименование) + '</p>' +
          '<p><strong>ПА:</strong> ' + escHtml(launch.номерПА) + '</p>' +
          '<p><strong>Всего:</strong> ' + launch.колВо + '</p>';

        document.getElementById('issueQty').value = launch.колВо;
        document.getElementById('issueModal').style.display = 'flex';
      } catch (e) {
        showToast(e.message, true);
      }
    }

    function closeIssueModal() {
      document.getElementById('issueModal').style.display = 'none';
      currentLaunch = null;
    }

    async function submitIssue() {
      if (!currentLaunch) return;
      var оператор = document.getElementById('issueOperator').value;
      var станок = document.getElementById('issueMachine').value;
      var колВо = parseFloat(document.getElementById('issueQty').value);

      if (!оператор) { showToast('Выберите оператора', true); return; }
      if (!колВо || колВо <= 0) { showToast('Укажите количество', true); return; }

      try {
        await api('/api/work-orders/issue', {
          method: 'POST',
          body: {
            launchId: currentLaunch.id,
            кодДетали: currentLaunch.кодДетали,
            наименование: currentLaunch.наименование,
            обозначение: currentLaunch.обозначение || '',
            узел: currentLaunch.узел || '',
            оператор: оператор,
            станок: станок,
            колВо: колВо
          }
        });
        showToast('Наряд выдан');
        closeIssueModal();
        loadLaunches();
      } catch (e) {
        showToast(e.message, true);
      }
    }

    document.getElementById('filterSearch').addEventListener('input', function() {
      clearTimeout(this._timer);
      var input = this;
      this._timer = setTimeout(function() { renderLaunches(null); loadLaunches(); }, 300);
    });

    loadLaunches();
  </script>
</body>
</html>